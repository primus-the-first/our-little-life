rules_version = '2';

// Our Little Life: who can see and change what.
// Published in the Firebase console (Firestore > Rules). Keep this file and the console in step.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /worlds/{worldId} {
      function isMember() {
        return signedIn() && request.auth.uid in resource.data.members;
      }

      function stateIsSane() {
        return request.resource.data.state is string && request.resource.data.state.size() < 500000;
      }

      // Only the two members can see their world. Listing is only used to find your own world.
      allow get, list: if isMember();

      // A new world starts with its creator as the only member.
      allow create: if signedIn()
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.keys().hasOnly(['code', 'mode', 'members', 'state', 'updatedAt'])
        && stateIsSane();

      // Members play: they change the game state and nothing else.
      allow update: if isMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'updatedAt'])
        && stateIsSane();

      // Someone with the code joins by adding only themselves, and only while there's room.
      allow update: if signedIn()
        && !(request.auth.uid in resource.data.members)
        && resource.data.members.size() < 2
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members == resource.data.members.concat([request.auth.uid]);

      allow delete: if false;
    }

    match /codes/{code} {
      // Anyone signed in can look up one code they were given, but can't list them all.
      allow get: if signedIn();

      // Only a world's creator registers its code, once.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['worldId'])
        && get(/databases/$(database)/documents/worlds/$(request.resource.data.worldId)).data.members[0] == request.auth.uid;

      allow update, delete: if false;
    }
  }
}
